import argparse
import sys

from . import top


def main(argv=None):
    p = argparse.ArgumentParser(prog="tally", description="count the most frequent words in a file")
    p.add_argument("path")
    p.add_argument("-n", type=int, default=3, help="how many words to show")
    a = p.parse_args(argv)
    text = open(a.path, encoding="utf-8").read()
    for word, n in top(text, a.n):
        print(f"{n:6d}  {word}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""tally: a tiny word-frequency tool used as a coding-agent sandbox."""
from collections import Counter


def count_words(text: str) -> Counter:
    return Counter(w.lower() for w in text.split())


def top(text: str, n: int = 3):
    return count_words(text).most_common(n)
