@@ -1,4 +1,5 @@
 from tally import count_words, top
+from tally.cli import main
 
 
 def test_count_is_case_insensitive():
@@ -7,3 +8,29 @@ def test_count_is_case_insensitive():
 
 def test_top_orders_by_count():
     assert top("x y y z z z", 2) == [("z", 3), ("y", 2)]
+
+
+def test_ignore_punctuation_collapses_words():
+    # 'hello,' and 'hello' count as the same word
+    assert count_words("hello, hello", ignore_punctuation=True)["hello"] == 2
+
+
+def test_default_keeps_punctuation():
+    # without the flag, 'hello,' and 'hello' stay distinct
+    c = count_words("hello, hello")
+    assert c["hello"] == 1
+    assert c["hello,"] == 1
+
+
+def test_cli_ignore_punctuation_flag(tmp_path, capsys):
+    f = tmp_path / "words.txt"
+    f.write_text("hello, hello hello!\n", encoding="utf-8")
+    rc = main([str(f), "--ignore-punctuation", "-n", "5"])
+    out = capsys.readouterr().out
+    assert rc == 0
+    lines = [l for l in out.splitlines() if l.strip()]
+    # all three tokens collapse to 'hello'
+    assert len(lines) == 1
+    count, word = lines[0].split()
+    assert word == "hello"
+    assert count == "3"
