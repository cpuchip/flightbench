{"type":"item.completed","item":{"id":"item_22","type":"mcp_tool_call","server":"flightbench","tool":"mission_rules_lookup","arguments":{"topic":"sps gimbal"},"result":{"content":[{"type":"text","text":"{\"topic\": \"gimbal\", \"text\": \"SPS GIMBAL: no SPS burn is executed unless both the primary and the backup gimbal servo are verified nominal. A backup servo oscillating is a NO-GO for the burn until an engineering evaluation (request_evaluation) clears it or waives it on the Flight Director's authority. Flight cannot order the burn around this rule; the position holds and transfers.\"}"}],"structured_content":{"result":"{\"topic\": \"gimbal\", \"text\": \"SPS GIMBAL: no SPS burn is executed unless both the primary and the backup gimbal servo are verified nominal. A backup servo oscillating is a NO-GO for the burn until an engineering evaluation (request_evaluation) clears it or waives it on the Flight Director's authority. Flight cannot order the burn around this rule; the position holds and transfers.\"}"}},"error":null,"status":"completed"}}
